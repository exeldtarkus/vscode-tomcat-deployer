{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": [
      "ES2022"
    ],

    "outDir": "out",
    "rootDir": "src",

    "sourceMap": true,

    "strict": true,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "types": [
      "node",
      "vscode"
    ]
  },

  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}